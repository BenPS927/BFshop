generator client {
  provider = "prisma-client"
  output   = "../src/generated/dev-log-prisma"
}

datasource db {
  provider = "postgresql"
}

model dev_log {
  id             Int       @id @default(autoincrement())
  notion_page_id String?   @unique
  title          String
  content        String
  published_at   DateTime  @db.Timestamptz(6)
  last_edited_at DateTime? @db.Timestamptz(6)
}
